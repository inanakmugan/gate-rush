<?xml version="1.0" encoding="utf-8"?>
<!-- Line coverage for the four engine-free assemblies only. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[GateRush.Core]*,[GateRush.Platform]*,[GateRush.Meta]*,[GateRush.Solver]*</Include>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
