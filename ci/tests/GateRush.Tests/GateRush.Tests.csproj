<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Edit Mode tests that build without Unity, compiled unchanged from
    Assets/Tests. The list is explicit: a test file is added here only once it
    compiles against the four engine-free assemblies and NUnit alone.
    ci/README.md lists the files left out and why.
  -->
  <PropertyGroup>
    <AssemblyName>GateRush.Tests</AssemblyName>
    <RootNamespace>GateRush.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>
  <ItemGroup>
