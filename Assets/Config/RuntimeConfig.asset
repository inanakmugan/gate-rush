  jokerIntroductions:
  - joker: 0
    title: Clock!
    text: Tap it to add {0} seconds to the clock.
  - joker: 1
    title: Rocket!
    text: Tap the Rocket, then a block, to clear its colour.
  - joker: 2
    title: Broom!
    text: Tap the Broom, then a block, to clear that colour from every block.
